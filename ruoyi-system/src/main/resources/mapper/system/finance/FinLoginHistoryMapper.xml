<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.finance.FinLoginHistoryMapper">
    
    <resultMap type="com.ruoyi.system.domain.finance.FinLoginHistory" id="FinLoginHistoryResult">
        <result property="id"     column="id"     />
        <result property="userId"     column="user_id"     />
        <result property="loginTime"   column="login_time"   />
        <result property="ipAddress"   column="ip_address"   />
        <result property="deviceInfo"   column="device_info"   />
        <result property="success"   column="success"   />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"     />
    </resultMap>

    <sql id="selectFinLoginHistoryVo">
        select id, user_id, login_time, ip_address, device_info, success, create_by, create_time, update_by, update_time, remark
        from fin_login_history
    </sql>

    <select id="selectFinLoginHistoryList" parameterType="com.ruoyi.system.domain.finance.FinLoginHistory" resultMap="FinLoginHistoryResult">
        <include refid="selectFinLoginHistoryVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="loginTime != null "> and login_time = #{loginTime}</if>
            <if test="ipAddress != null  and ipAddress != ''"> and ip_address = #{ipAddress}</if>
            <if test="success != null "> and success = #{success}</if>
            <if test="params.beginTime != null and params.beginTime != '' and params.endTime != null and params.endTime != ''"> and login_time between #{params.beginTime} and #{params.endTime}</if>
        </where>
        order by login_time desc
    </select>
    
    <select id="selectFinLoginHistoryById" parameterType="Long" resultMap="FinLoginHistoryResult">
        <include refid="selectFinLoginHistoryVo"/>
        where id = #{id}
    </select>
    
    <select id="selectLatestLoginByUserId" parameterType="Long" resultMap="FinLoginHistoryResult">
        <include refid="selectFinLoginHistoryVo"/>
        where user_id = #{userId} and success = 1
        order by login_time desc limit 1
    </select>
        
    <insert id="insertFinLoginHistory" parameterType="com.ruoyi.system.domain.finance.FinLoginHistory" useGeneratedKeys="true" keyProperty="id">
        insert into fin_login_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="loginTime != null">login_time,</if>
            <if test="ipAddress != null">ip_address,</if>
            <if test="deviceInfo != null">device_info,</if>
            <if test="success != null">success,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="loginTime != null">#{loginTime},</if>
            <if test="ipAddress != null">#{ipAddress},</if>
            <if test="deviceInfo != null">#{deviceInfo},</if>
            <if test="success != null">#{success},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <delete id="deleteFinLoginHistoryById" parameterType="Long">
        delete from fin_login_history where id = #{id}
    </delete>

    <delete id="deleteFinLoginHistoryByIds" parameterType="Long">
        delete from fin_login_history where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>