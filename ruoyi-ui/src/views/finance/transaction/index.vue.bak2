<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryForm" size="small" :inline="true" v-show="showSearch" label-width="68px">
      <el-form-item label="鐢ㄦ埛ID" prop="userId" v-if="isAdmin">
        <el-input v-model="queryParams.userId" placeholder="璇疯緭鍏ョ敤鎴稩D" clearable style="width: 240px" @keyup.enter.native="handleQuery" />
      </el-form-item>
      <el-form-item label="鍒嗙被" prop="categoryId">
        <el-select v-model="queryParams.categoryId" placeholder="璇烽€夋嫨鍒嗙被" clearable style="width: 240px">
          <el-option v-for="item in categoryOptions" :key="item.id" :label="item.name" :value="item.id" />
        </el-select>
      </el-form-item>
      <el-form-item label="绫诲瀷" prop="type">
        <el-select v-model="queryParams.type" placeholder="璇烽€夋嫨绫诲瀷" clearable style="width: 240px">
          <el-option label="鏀嚭" :value="1" />
          <el-option label="鏀跺叆" :value="2" />
        </el-select>
      </el-form-item>
      <el-form-item label="閲戦" prop="amount">
        <el-input v-model="queryParams.amount" placeholder="璇疯緭鍏ラ噾棰? clearable style="width: 240px" @keyup.enter.native="handleQuery" />
      </el-form-item>
      <el-form-item label="浜ゆ槗鏃堕棿">
        <el-date-picker
          v-model="dateRange"
          style="width: 240px"
          value-format="timestamp"
          type="daterange"
          range-separator="-"
          start-placeholder="寮€濮嬫棩鏈?
          end-placeholder="缁撴潫鏃ユ湡"
        ></el-date-picker>
      </el-form-item>
      <el-form-item label="澶囨敞" prop="note">
        <el-input v-model="queryParams.note" placeholder="璇疯緭鍏ュ娉? clearable style="width: 240px" @keyup.enter.native="handleQuery" />
      </el-form-item>
      <el-form-item>
        <el-button type="primary" icon="el-icon-search" size="mini" @click="handleQuery">鎼滅储</el-button>
        <el-button icon="el-icon-refresh" size="mini" @click="resetQuery">閲嶇疆</el-button>
      </el-form-item>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button type="primary" plain icon="el-icon-plus" size="mini" @click="handleAdd" v-hasPermi="['finance:transaction:add']">鏂板</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="success" plain icon="el-icon-edit" size="mini" :disabled="single" @click="handleUpdate" v-hasPermi="['finance:transaction:edit']">淇敼</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="danger" plain icon="el-icon-delete" size="mini" :disabled="multiple" @click="handleDelete" v-hasPermi="['finance:transaction:remove']">鍒犻櫎</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="warning" plain icon="el-icon-download" size="mini" @click="handleExport" v-hasPermi="['finance:transaction:export']">瀵煎嚭</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="info" plain icon="el-icon-s-data" size="mini" @click="handleStatistics" v-hasPermi="['finance:transaction:query']">缁熻</el-button>
      </el-col>
      <right-toolbar :showSearch.sync="showSearch" @queryTable="getList" :columns="columns"></right-toolbar>
    </el-row>

    <el-table v-loading="loading" :data="transactionList" @selection-change="handleSelectionChange">
      <el-table-column type="selection" width="55" align="center" />
      <el-table-column label="浜ゆ槗ID" align="center" prop="id" v-if="columns[0].visible" />
      <el-table-column label="鐢ㄦ埛ID" align="center" prop="userId" v-if="columns[1].visible && isAdmin" />
      <el-table-column label="鍒嗙被" align="center" prop="categoryName" v-if="columns[2].visible" :show-overflow-tooltip="true" />
      <el-table-column label="閲戦" align="center" prop="amount" v-if="columns[3].visible" />
      <el-table-column label="绫诲瀷" align="center" prop="type" v-if="columns[4].visible">
        <template slot-scope="scope">
          <el-tag type="danger" v-if="scope.row.type == 1">鏀嚭</el-tag>
          <el-tag type="success" v-else>鏀跺叆</el-tag>
        </template>
      </el-table-column>
      <el-table-column label="浜ゆ槗鏃堕棿" align="center" prop="transactionTime" v-if="columns[5].visible" width="180">
        <template slot-scope="scope">
          <span>{{ parseTime(scope.row.transactionTime) }}</span>
        </template>
      </el-table-column>
      <el-table-column label="澶囨敞" align="center" prop="note" v-if="columns[6].visible" :show-overflow-tooltip="true" />
      <el-table-column label="绁ㄦ嵁" align="center" prop="imagePath" v-if="columns[7].visible" width="100">
        <template slot-scope="scope">
          <el-image 
            v-if="scope.row.imagePath"
            style="width: 50px; height: 50px"
            :src="scope.row.imagePath.startsWith('http') ? scope.row.imagePath : getImageUrl(scope.row.imagePath)" 
            :preview-src-list="scope.row.imagePath ? [scope.row.imagePath.startsWith('http') ? scope.row.imagePath : getImageUrl(scope.row.imagePath)] : []"
            fit="cover">
            <div slot="error" class="image-slot">
              <i class="el-icon-picture-outline"></i>
            </div>
          </el-image>
          <span v-else>鏃?/span>
        </template>
      </el-table-column>
      <el-table-column label="鎿嶄綔" align="center" width="160" class-name="small-padding fixed-width">
        <template slot-scope="scope">
          <el-button size="mini" type="text" icon="el-icon-edit" @click="handleUpdate(scope.row)" v-hasPermi="['finance:transaction:edit']">淇敼</el-button>
          <el-button size="mini" type="text" icon="el-icon-delete" @click="handleDelete(scope.row)" v-hasPermi="['finance:transaction:remove']">鍒犻櫎</el-button>
        </template>
      </el-table-column>
    </el-table>

    <pagination v-show="total > 0" :total="total" :page.sync="queryParams.pageNum" :limit.sync="queryParams.pageSize" @pagination="getList" />

    <!-- 娣诲姞鎴栦慨鏀逛氦鏄撹褰曞璇濇 -->
    <el-dialog :title="title" :visible.sync="open" width="600px" append-to-body>
      <el-form ref="form" :model="form" :rules="rules" label-width="100px">
        <el-form-item label="绫诲瀷" prop="type">
          <el-radio-group v-model="form.type" @change="handleTypeChange">
            <el-radio :label="1">鏀嚭</el-radio>
            <el-radio :label="2">鏀跺叆</el-radio>
          </el-radio-group>
        </el-form-item>
        <el-form-item label="鍒嗙被" prop="categoryId">
          <el-select v-model="form.categoryId" placeholder="璇烽€夋嫨鍒嗙被" style="width: 100%">
            <el-option
              v-for="item in currentCategoryOptions"
              :key="item.id"
              :label="item.name"
              :value="item.id"
            >
              <span><i :class="'el-icon-' + item.icon" :style="{color: item.color}"></i> {{ item.name }}</span>
            </el-option>
          </el-select>
        </el-form-item>
        <el-form-item label="閲戦" prop="amount">
          <el-input-number v-model="form.amount" :min="0.01" :precision="2" :step="1" style="width: 100%" />
        </el-form-item>
        <el-form-item label="浜ゆ槗鏃堕棿" prop="transactionTime">
          <el-date-picker
            v-model="form.transactionTime"
            type="datetime"
            placeholder="閫夋嫨鏃ユ湡鏃堕棿"
            style="width: 100%"
            value-format="timestamp"
          ></el-date-picker>
        </el-form-item>
        <el-form-item label="澶囨敞" prop="note">
          <el-input v-model="form.note" type="textarea" placeholder="璇疯緭鍏ュ娉? />
        </el-form-item>
        <el-form-item label="绁ㄦ嵁鍥剧墖" prop="imagePath">
          <el-upload name="file"
            ref="upload"
            :limit="1"
            accept=".jpg, .png, .jpeg"
            :action="upload.url"
            :headers="upload.headers"
            :file-list="upload.fileList"
            :on-progress="handleFileUploadProgress"
            :on-success="handleFileSuccess"
            :on-error="handleUploadError"
            :on-exceed="handleExceed"
            :on-remove="handleRemove"
            :on-preview="handlePictureCardPreview"
            :before-upload="handleBeforeUpload"
            list-type="picture-card"
            :class="{hide: upload.fileList.length >= 1}">
            <i class="el-icon-plus"></i>
          </el-upload>
          <!-- 涓婁紶鎻愮ず -->
          <div class="el-upload__tip" slot="tip">鍙兘涓婁紶jpg/png/jpeg鏂囦欢锛屼笖涓嶈秴杩?MB</div>
          
          <el-dialog
            :visible.sync="dialogVisible"
            title="棰勮"
            width="800"
            append-to-body
          >
            <img
              :src="dialogImageUrl"
              style="display: block; max-width: 100%; margin: 0 auto"
            />
          </el-dialog>
        </el-form-item>
        <el-form-item label="浣嶇疆淇℃伅" prop="location">
          <el-input v-model="form.location" placeholder="璇疯緭鍏ヤ綅缃俊鎭? />
        </el-form-item>
      </el-form>
      <div slot="footer" class="dialog-footer">
        <el-button type="primary" @click="submitForm">纭?瀹?/el-button>
        <el-button @click="cancel">鍙?娑?/el-button>
      </div>
    </el-dialog>
    
    <!-- 缁熻鍥捐〃瀵硅瘽妗?-->
    <el-dialog title="浜ゆ槗缁熻" :visible.sync="statOpen" width="900px" append-to-body>
      <el-tabs v-model="activeTab">
        <el-tab-pane label="鏈堝害鏀舵敮缁熻" name="month">
          <div class="stat-header">
            <el-date-picker
              v-model="statMonth"
              type="month"
              placeholder="閫夋嫨鏈堜唤"
              @change="handleMonthChange"
              value-format="yyyy-MM"
            ></el-date-picker>
            <div class="stat-summary">
              <div class="stat-item">
                <div class="stat-label">鏀嚭</div>
                <div class="stat-value expense">{{ formatAmount(monthSummary.expense) }}</div>
              </div>
              <div class="stat-item">
                <div class="stat-label">鏀跺叆</div>
                <div class="stat-value income">{{ formatAmount(monthSummary.income) }}</div>
              </div>
              <div class="stat-item">
                <div class="stat-label">缁撲綑</div>
                <div class="stat-value" :class="{ 'income': monthSummary.balance >= 0, 'expense': monthSummary.balance < 0 }">
                  {{ formatAmount(monthSummary.balance) }}
                </div>
              </div>
            </div>
          </div>
          <el-tabs v-model="chartTab" @tab-click="handleChartTabChange">
            <el-tab-pane label="鏀嚭鍒嗙被" name="expense">
              <div id="expenseChart" class="chart"></div>
            </el-tab-pane>
            <el-tab-pane label="鏀跺叆鍒嗙被" name="income">
              <div id="incomeChart" class="chart"></div>
            </el-tab-pane>
          </el-tabs>
        </el-tab-pane>
        <el-tab-pane label="骞村害鏀舵敮瓒嬪娍" name="year">
          <div class="stat-header">
            <el-date-picker
              v-model="statYear"
              type="year"
              placeholder="閫夋嫨骞翠唤"
              @change="handleYearChange"
              value-format="yyyy"
            ></el-date-picker>
          </div>
          <div id="yearChart" class="chart"></div>
        </el-tab-pane>
      </el-tabs>
    </el-dialog>
  </div>
</template>

<script>
import { listTransaction, getTransaction, delTransaction, addTransaction, updateTransaction, exportTransaction,
  getMonthAmount, getMonthStat, getYearStat } from "@/api/finance/transaction";
import { listCategoryByType } from "@/api/finance/category";
import * as echarts from 'echarts';
import ImageUpload from "@/components/ImageUpload";
import { getToken } from "@/utils/auth";

export default {
  name: "Transaction",
  components: {
    ImageUpload
  },
  data() {
    return {
      // 閬僵灞?      loading: true,
      // 閫変腑鏁扮粍
      ids: [],
      // 闈炲崟涓鐢?      single: true,
      // 闈炲涓鐢?      multiple: true,
      // 鏄剧ず鎼滅储鏉′欢
      showSearch: true,
      // 鎬绘潯鏁?      total: 0,
      // 浜ゆ槗璁板綍琛ㄦ牸鏁版嵁
      transactionList: [],
      // 寮瑰嚭灞傛爣棰?      title: "",
      // 鏄惁鏄剧ず寮瑰嚭灞?      open: false,
      // 鏄惁鏄剧ず缁熻瀵硅瘽妗?      statOpen: false,
      // 缁熻鍥捐〃褰撳墠閫夐」鍗?      activeTab: 'month',
      // 鍥捐〃绫诲瀷閫夐」鍗?      chartTab: 'expense',
      // 缁熻骞翠唤
      statYear: new Date().getFullYear().toString(),
      // 缁熻鏈堜唤
      statMonth: new Date().getFullYear() + '-' + (new Date().getMonth() + 1).toString().padStart(2, '0'),
      // 鏈堝害鏀舵敮姹囨€?      monthSummary: {
        expense: 0,
        income: 0,
        balance: 0
      },
      // 鏄惁涓虹鐞嗗憳
      isAdmin: false,
      // 鍒嗙被閫夐」
      categoryOptions: [],
      // 褰撳墠绫诲瀷瀵瑰簲鐨勫垎绫婚€夐」
      currentCategoryOptions: [],
      // 鏃ユ湡鑼冨洿
      dateRange: [],
      // 琛ㄦ牸灞曠ず鐨勫垪
      columns: [
        { key: 0, label: "浜ゆ槗ID", visible: false },
        { key: 1, label: "鐢ㄦ埛ID", visible: true },
        { key: 2, label: "鍒嗙被", visible: true },
        { key: 3, label: "閲戦", visible: true },
        { key: 4, label: "绫诲瀷", visible: true },
        { key: 5, label: "浜ゆ槗鏃堕棿", visible: true },
        { key: 6, label: "澶囨敞", visible: true },
        { key: 7, label: "绁ㄦ嵁", visible: true }
      ],
      // 鏌ヨ鍙傛暟
      queryParams: {
        pageNum: 1,
        pageSize: 10,
        userId: undefined,
        categoryId: undefined,
        amount: undefined,
        type: undefined,
        note: undefined
      },
      // 琛ㄥ崟鍙傛暟
      form: {},
      // 琛ㄥ崟鏍￠獙
      rules: {
        type: [
          { required: true, message: "浜ゆ槗绫诲瀷涓嶈兘涓虹┖", trigger: "change" }
        ],
        categoryId: [
          { required: true, message: "浜ゆ槗鍒嗙被涓嶈兘涓虹┖", trigger: "change" }
        ],
        amount: [
          { required: true, message: "浜ゆ槗閲戦涓嶈兘涓虹┖", trigger: "blur" }
        ],
        transactionTime: [
          { required: true, message: "浜ゆ槗鏃堕棿涓嶈兘涓虹┖", trigger: "blur" }
        ]
      },
      // 鍥捐〃瀹炰緥
      expenseChart: null,
      incomeChart: null,
      yearChart: null,
      // 涓婁紶鍙傛暟
      upload: {
        // 鏄惁绂佺敤涓婁紶
        isUploading: false,
        // 璁剧疆涓婁紶鐨勮姹傚ご閮?        headers: { Authorization: "Bearer " + getToken() },
        // 涓婁紶鐨勫湴鍧€
        url: process.env.VUE_APP_BASE_API + "/common/upload",
        // 涓婁紶鐨勬枃浠跺垪琛?        fileList: []
      },
      dialogVisible: false,
      dialogImageUrl: ''
    };
  },
  created() {
    this.getList();
    this.getCategoryOptions();
    this.isAdmin = this.$store.getters.roles.includes("admin");
  },
  methods: {
    /** 鑾峰彇鍥剧墖瀹屾暣URL */
    getImageUrl(path) {
      if (!path) return '';
      if (path.startsWith('http')) return path;
      return process.env.VUE_APP_BASE_API + path;
    },
    /** 鏌ヨ浜ゆ槗璁板綍鍒楄〃 */
    getList() {
      this.loading = true;
      
      // 澶勭悊浜ゆ槗鏃堕棿鑼冨洿鏌ヨ鍙傛暟
      if (this.dateRange && this.dateRange.length === 2) {
        this.queryParams.params = {
          beginTime: this.dateRange[0],
          endTime: this.dateRange[1]
        };
      } else {
        this.queryParams.params = {};
      }
      
      listTransaction(this.queryParams).then(response => {
        this.transactionList = response.rows;
        this.total = response.total;
        this.loading = false;
      });
    },
    /** 鑾峰彇鍒嗙被閫夐」 */
    getCategoryOptions() {
      // 鑾峰彇鏀嚭鍒嗙被
      listCategoryByType(1).then(response => {
        const expenseCategories = response.data || [];
        
        // 鑾峰彇鏀跺叆鍒嗙被
        listCategoryByType(2).then(response => {
          const incomeCategories = response.data || [];
          this.categoryOptions = [...expenseCategories, ...incomeCategories];
          
          // 璁剧疆褰撳墠绫诲瀷瀵瑰簲鐨勫垎绫伙紝榛樿涓烘敮鍑哄垎绫?          this.handleTypeChange(this.form.type || 1);
        });
      });
    },
    // 绫诲瀷鍙戠敓鍙樺寲鏃讹紝鏇存柊鍙€夊垎绫?    handleTypeChange(type) {
      this.currentCategoryOptions = this.categoryOptions.filter(item => item.type === type);
    },
    // 鍙栨秷鎸夐挳
    cancel() {
      this.open = false;
      this.reset();
    },
    // 琛ㄥ崟閲嶇疆
    reset() {
      this.form = {
        id: undefined,
        userId: undefined,
        categoryId: undefined,
        amount: undefined,
        type: 1,
        transactionTime: new Date().getTime(),
        note: undefined,
        location: undefined,
        syncState: 0
      };
      this.resetForm("form");
      this.handleTypeChange(1);
    },
    /** 鎼滅储鎸夐挳鎿嶄綔 */
    handleQuery() {
      this.queryParams.pageNum = 1;
      this.getList();
    },
    /** 閲嶇疆鎸夐挳鎿嶄綔 */
    resetQuery() {
      this.dateRange = [];
      this.resetForm("queryForm");
      this.handleQuery();
    },
    // 澶氶€夋閫変腑鏁版嵁
    handleSelectionChange(selection) {
      this.ids = selection.map(item => item.id);
      this.single = selection.length !== 1;
      this.multiple = !selection.length;
    },
    /** 鏂板鎸夐挳鎿嶄綔 */
    handleAdd() {
      this.reset();
      this.upload.fileList = [];
      this.open = true;
      this.title = "娣诲姞浜ゆ槗璁板綍";
    },
    /** 淇敼鎸夐挳鎿嶄綔 */
    handleUpdate(row) {
      this.reset();
      const id = row.id || this.ids[0];
      getTransaction(id).then(response => {
        this.form = response.data;
        // 濡傛灉鍥剧墖璺緞涓嶆槸瀹屾暣URL锛岃ˉ鍏ㄨ矾寰?        if (this.form.imagePath && !this.form.imagePath.startsWith('http')) {
          this.upload.fileList = [{ name: this.getFileName(this.form.imagePath), url: this.getImageUrl(this.form.imagePath) }];
        } else if (this.form.imagePath) {
          this.upload.fileList = [{ name: this.getFileName(this.form.imagePath), url: this.form.imagePath }];
        } else {
          this.upload.fileList = [];
        }
        this.handleTypeChange(this.form.type);
        this.open = true;
        this.title = "淇敼浜ゆ槗璁板綍";
      });
    },
    /** 鎻愪氦鎸夐挳 */
    submitForm() {
      this.$refs["form"].validate(valid => {
        if (valid) {
          if (this.upload.isUploading) {
            this.$modal.msgWarning("鍥剧墖姝ｅ湪涓婁紶涓紝璇风瓑寰呬笂浼犲畬鎴愬悗鍐嶆彁浜?);
            return;
          }
          
          if (this.form.id != null) {
            updateTransaction(this.form).then(response => {
              this.$modal.msgSuccess("淇敼鎴愬姛");
              this.open = false;
              this.getList();
            });
          } else {
            addTransaction(this.form).then(response => {
              this.$modal.msgSuccess("鏂板鎴愬姛");
              this.open = false;
              this.getList();
            });
          }
        }
      });
    },
    /** 鍒犻櫎鎸夐挳鎿嶄綔 */
    handleDelete(row) {
      const ids = row.id || this.ids;
      this.$modal.confirm('鏄惁纭鍒犻櫎浜ゆ槗璁板綍缂栧彿涓?' + ids + '"鐨勬暟鎹」锛?).then(function() {
        return delTransaction(ids);
      }).then(() => {
        this.getList();
        this.$modal.msgSuccess("鍒犻櫎鎴愬姛");
      }).catch(() => {});
    },
    /** 瀵煎嚭鎸夐挳鎿嶄綔 */
    handleExport() {
      this.download('finance/transaction/export', {
        ...this.queryParams
      }, `transaction_${new Date().getTime()}.xlsx`);
    },
    /** 缁熻鎸夐挳鎿嶄綔 */
    handleStatistics() {
      this.statOpen = true;
      this.activeTab = 'month';
      this.chartTab = 'expense';
      
      // 鍒濆鍖栫粺璁℃暟鎹?      this.loadMonthSummary();
      this.loadMonthStat();
      
      // 寤惰繜鍔犺浇鍥捐〃锛岀‘淇滵OM宸叉覆鏌?      this.$nextTick(() => {
        this.initCharts();
      });
    },
    /** 鍒濆鍖栧浘琛?*/
    initCharts() {
      // 濡傛灉鍥捐〃瀹炰緥宸插瓨鍦紝鍏堥攢姣?      if (this.expenseChart) {
        this.expenseChart.dispose();
      }
      if (this.incomeChart) {
        this.incomeChart.dispose();
      }
      if (this.yearChart) {
        this.yearChart.dispose();
      }
      
      // 鍒濆鍖栨敮鍑哄垎绫诲浘琛?      this.expenseChart = echarts.init(document.getElementById('expenseChart'));
      
      // 鍒濆鍖栨敹鍏ュ垎绫诲浘琛?      this.incomeChart = echarts.init(document.getElementById('incomeChart'));
      
      // 鍒濆鍖栧勾搴﹁秼鍔垮浘琛?      this.yearChart = echarts.init(document.getElementById('yearChart'));
      
      // 鍔犺浇骞村害鏁版嵁
      this.loadYearStat();
    },
    /** 鍔犺浇鏈堝害鏀舵敮姹囨€?*/
    loadMonthSummary() {
      const year = parseInt(this.statMonth.split('-')[0]);
      const month = parseInt(this.statMonth.split('-')[1]);
      
      // 璁＄畻鏈堝垵鍜屾湀鏈椂闂存埑
      const startDate = new Date(year, month - 1, 1);
      const endDate = new Date(year, month, 0, 23, 59, 59);
      
      const startTime = startDate.getTime();
      const endTime = endDate.getTime();
      
      getMonthAmount(this.$store.getters.userId, startTime, endTime).then(response => {
        this.monthSummary = response.data || { expense: 0, income: 0, balance: 0 };
      });
    },
    /** 鍔犺浇鏈堝害鍒嗙被缁熻 */
    loadMonthStat() {
      const year = parseInt(this.statMonth.split('-')[0]);
      const month = parseInt(this.statMonth.split('-')[1]);
      
      // 璁＄畻鏈堝垵鍜屾湀鏈椂闂存埑
      const startDate = new Date(year, month - 1, 1);
      const endDate = new Date(year, month, 0, 23, 59, 59);
      
      const startTime = startDate.getTime();
      const endTime = endDate.getTime();
      
      // 鍔犺浇鏀嚭鍒嗙被缁熻
      getMonthStat(this.$store.getters.userId, startTime, endTime, 1).then(response => {
        const data = response.data || [];
        this.updatePieChart(this.expenseChart, data, '鏀嚭鍒嗙被鍗犳瘮');
      });
      
      // 鍔犺浇鏀跺叆鍒嗙被缁熻
      getMonthStat(this.$store.getters.userId, startTime, endTime, 2).then(response => {
        const data = response.data || [];
        this.updatePieChart(this.incomeChart, data, '鏀跺叆鍒嗙被鍗犳瘮');
      });
    },
    /** 鍔犺浇骞村害缁熻 */
    loadYearStat() {
      getYearStat(this.$store.getters.userId, parseInt(this.statYear)).then(response => {
        const data = response.data || [];
        
        // 鍑嗗鍥捐〃鏁版嵁
        const months = [];
        const expenses = [];
        const incomes = [];
        
        // 濉厖鏈堜唤鏁版嵁锛岀‘淇?2涓湀閮芥湁鏁版嵁
        for (let i = 1; i <= 12; i++) {
          const monthData = data.find(item => item.month === i) || { month: i, expense: 0, income: 0 };
          months.push(i + '鏈?);
          expenses.push(parseFloat(monthData.expense) || 0);
          incomes.push(parseFloat(monthData.income) || 0);
        }
        
        // 鏇存柊骞村害瓒嬪娍鍥?        this.yearChart.setOption({
          title: {
            text: this.statYear + '骞存敹鏀秼鍔?,
            left: 'center'
          },
          tooltip: {
            trigger: 'axis',
            formatter: function(params) {
              let result = params[0].name + '<br/>';
              params.forEach(item => {
                result += item.seriesName + ': ' + item.value.toFixed(2) + '<br/>';
              });
              return result;
            }
          },
          legend: {
            data: ['鏀嚭', '鏀跺叆'],
            bottom: '5%'
          },
          grid: {
            left: '3%',
            right: '4%',
            bottom: '15%',
            containLabel: true
          },
          xAxis: {
            type: 'category',
            data: months
          },
          yAxis: {
            type: 'value',
            axisLabel: {
              formatter: '{value} 鍏?
            }
          },
          series: [
            {
              name: '鏀嚭',
              type: 'line',
              data: expenses,
              itemStyle: {
                color: '#f56c6c'
              }
            },
            {
              name: '鏀跺叆',
              type: 'line',
              data: incomes,
              itemStyle: {
                color: '#67c23a'
              }
            }
          ]
        });
      });
    },
    /** 鏇存柊楗煎浘 */
    updatePieChart(chart, data, title) {
      const chartData = data.map(item => ({
        name: item.category_name,
        value: parseFloat(item.amount),
        itemStyle: {
          color: item.color
        }
      }));
      
      chart.setOption({
        title: {
          text: title,
          left: 'center'
        },
        tooltip: {
          trigger: 'item',
          formatter: '{b}: {c} ({d}%)'
        },
        legend: {
          orient: 'vertical',
          left: 'left',
          data: chartData.map(item => item.name)
        },
        series: [
          {
            name: title,
            type: 'pie',
            radius: '55%',
            center: ['50%', '60%'],
            data: chartData,
            emphasis: {
              itemStyle: {
                shadowBlur: 10,
                shadowOffsetX: 0,
                shadowColor: 'rgba(0, 0, 0, 0.5)'
              }
            }
          }
        ]
      });
    },
    /** 鏍煎紡鍖栭噾棰?*/
    formatAmount(amount) {
      return parseFloat(amount).toFixed(2) + ' 鍏?;
    },
    /** 鏈堜唤鍙樺寲浜嬩欢 */
    handleMonthChange() {
      this.loadMonthSummary();
      this.loadMonthStat();
    },
    /** 骞翠唤鍙樺寲浜嬩欢 */
    handleYearChange() {
      this.loadYearStat();
    },
    /** 鍥捐〃閫夐」鍗″垏鎹簨浠?*/
    handleChartTabChange() {
      this.$nextTick(() => {
        if (this.chartTab === 'expense') {
          this.expenseChart && this.expenseChart.resize();
        } else {
          this.incomeChart && this.incomeChart.resize();
        }
      });
    },
    /** 鑾峰彇鏂囦欢鍚?*/
    getFileName(path) {
      if (!path) return '';
      return path.substring(path.lastIndexOf("/") + 1);
    },
    // 鏂囦欢鎻愪氦澶勭悊
    submitUpload() {
      this.$refs.upload.submit();
    },
    // 鏂囦欢涓婁紶涓鐞?    handleFileUploadProgress(event, file, fileList) {
      this.upload.isUploading = true;
    },
    // 鏂囦欢涓婁紶鎴愬姛澶勭悊
    handleFileSuccess(response, file, fileList) {
      this.upload.isUploading = false;
      this.form.imagePath = response.url;
      this.$modal.msgSuccess(response.msg || "涓婁紶鎴愬姛");
    },
    handleUploadError(error, file) {
      this.$modal.msgError("涓婁紶澶辫触锛岃妫€鏌ョ綉缁滆繛鎺ユ垨鏂囦欢鏍煎紡");
    },
    handleExceed(files, fileList) {
      this.$modal.msgWarning("鍙兘涓婁紶涓€涓枃浠讹紝璇峰厛鍒犻櫎宸蹭笂浼犵殑鏂囦欢");
    },
    handleRemove(file, fileList) {
      this.upload.fileList = fileList;
    },
    handlePictureCardPreview(file) {
      this.dialogImageUrl = file.url;
      this.dialogVisible = true;
    },
    handleBeforeUpload(file) {
      const isJPG = file.type === 'image/jpeg';
      const isPNG = file.type === 'image/png';
      const isJPEG = file.type === 'image/jpg';
      const isLt5M = file.size / 1024 / 1024 < 5;

      if (!isJPG && !isPNG && !isJPEG) {
        this.$modal.msgWarning('涓婁紶鏂囦欢蹇呴』鏄?jpg/png/jpeg 鏍煎紡!');
      }
      if (!isLt5M) {
        this.$modal.msgWarning('涓婁紶鏂囦欢澶у皬涓嶈兘瓒呰繃 5MB!');
      }
      return isJPG || isPNG || isJPEG && isLt5M;
    }
  }
};
</script>

<style scoped>
.chart {
  width: 100%;
  height: 400px;
}
.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.stat-summary {
  display: flex;
  gap: 30px;
}
.stat-item {
  text-align: center;
}
.stat-label {
  font-size: 14px;
  color: #606266;
}
.stat-value {
  font-size: 18px;
  font-weight: bold;
  margin-top: 5px;
}
.expense {
  color: #f56c6c;
}
.income {
  color: #67c23a;
}

.image-slot {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  background: #f5f7fa;
  color: #909399;
  font-size: 18px;
}

.image-preview {
  margin-top: 10px;
  display: flex;
  justify-content: center;
}

/* 涓婁紶缁勪欢鏍峰紡 */
::v-deep .hide .el-upload--picture-card {
  display: none;
}
</style> 


